---
layout: layouts/base.njk
title: Items
permalink: /items/index.html
---

<section class="panel">
  <div class="page-title">
    <h1>Latest items</h1>
    {% if ingested and ingested.run %}
      <div class="subtle">
        Last ingest: {{ ingested.run.finishedAt }} &middot; {{ ingested.run.entriesNew }} new
      </div>
    {% else %}
      <div class="subtle">No ingested data yet</div>
    {% endif %}
  </div>

  {% if ingested and ingested.items and ingested.items.length %}
    <p class="lede">
      These are normalized feed entries with deterministic scoring, first-pass classification, and cross-source dedup metadata.
      (This page does not collapse duplicates; see <a href="{{ '/candidates/' | url }}">Candidates</a> for the deduped shortlist.)
    </p>

    <ol class="items">
      {% for item in ingested.items %}
        <li class="item">
          <h3 class="item__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
          {% if item.snippet %}
            <p class="item__body">{{ item.snippet }}</p>
          {% endif %}
          <div class="meta">
            {% if item.score is not none %}
              <span class="pill">Score: {{ item.score }}</span>
            {% endif %}
            {% if item.classification %}
              <span class="{{ item.classification.impactLevel | impactClass }}">{{ item.classification.impactLevel | upper }} impact</span>
              <span class="pill">{{ item.classification.impactArea }}</span>
              {% for tag in item.classification.tags %}
                <span class="pill">#{{ tag }}</span>
              {% endfor %}
            {% endif %}
            {% if item.publishedAt %}
              <span class="pill">{{ item.publishedAt }}</span>
            {% endif %}
            {% if item.sourceName %}
              <span class="pill">{{ item.sourceName }}</span>
            {% endif %}
            {% if item.category %}
              <span class="pill">{{ item.category }}</span>
            {% endif %}
            {% if item.dedup and item.dedup.groupSize and item.dedup.groupSize > 1 %}
              {% if item.dedup.isCanonical %}
                <span class="pill">dedup: canonical ({{ item.dedup.groupSize }})</span>
              {% else %}
                <span class="pill">dedup: duplicate ({{ item.dedup.groupSize }})</span>
              {% endif %}
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ol>
  {% else %}
    <p class="kicker">
      Run <code>npm run ingest</code> then <code>npm run artifacts</code> to fetch configured RSS/Atom feeds and generate
      <code>artifacts/ingested.json</code> and derived publish artifacts.
    </p>
  {% endif %}
</section>
