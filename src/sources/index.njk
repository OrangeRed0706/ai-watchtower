---
layout: layouts/base.njk
title: Sources
permalink: /sources/index.html
---

<section class="panel">
  <div class="page-title">
    <h1>Sources</h1>
    <div class="subtle">{{ sources.length }} configured</div>
  </div>
  <p class="kicker">
    This list comes from <code>config/sources.json</code> when present, otherwise it falls back to sample data.
  </p>

  <ul class="items">
    {% for s in sources %}
      <li class="item">
        <h3><a href="{{ s.url }}">{{ s.name }}</a></h3>
        <div class="meta">
          <span class="pill">{{ s.category }}</span>
          {% if s.tier %}
            <span class="pill">tier: {{ s.tier }}</span>
          {% endif %}
          {% if s.priority is not none %}
            <span class="pill">priority: {{ s.priority }}</span>
          {% endif %}
          {% if s.sourceType %}
            <span class="pill">{{ s.sourceType }}</span>
          {% endif %}
          <span class="pill">id: {{ s.id }}</span>
          {% if ingested and ingested.sources %}
            {% for rs in ingested.sources %}
              {% if rs.id == s.id and rs.lastFetch %}
                {% if rs.lastFetch.ok %}
                  <span class="badge badge--low">OK</span>
                {% else %}
                  <span class="badge badge--high">ERROR</span>
                {% endif %}
                {% if rs.lastFetch.status %}
                  <span class="pill">HTTP {{ rs.lastFetch.status }}</span>
                {% endif %}
                {% if rs.lastFetch.at %}
                  <span class="pill">{{ rs.lastFetch.at }}</span>
                {% endif %}
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
        {% if s.notes %}
          <p>{{ s.notes }}</p>
        {% endif %}
        {% if ingested and ingested.sources %}
          {% for rs in ingested.sources %}
            {% if rs.id == s.id and rs.lastFetch and rs.lastFetch.error %}
              <p class="kicker"><strong>Last error:</strong> {{ rs.lastFetch.error }}</p>
            {% endif %}
          {% endfor %}
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</section>
