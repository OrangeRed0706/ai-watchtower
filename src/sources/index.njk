---
layout: layouts/base.njk
title: Sources
permalink: /sources/index.html
---

<section class="panel">
  <div class="page-title">
    <h1>Sources</h1>
    <div class="subtle">{{ sources.length }} configured</div>
  </div>
  <p class="lede">
    Curated sources scanned for AI developments. Each item links back to its original publisher.
  </p>
  <details class="details">
    <summary>Configuration</summary>
    <p class="kicker--spaced">
      This list is driven by repository configuration when present; local/dev runs may fall back to a minimal default set.
    </p>
  </details>

  <ul class="items">
    {% for s in sources %}
      <li class="item">
        <h3 class="item__title"><a href="{{ s.url }}">{{ s.name }}</a></h3>
        <div class="meta">
          <span class="pill">{{ s.category }}</span>
          {% if s.tier %}
            <span class="pill">{{ s.tier }}</span>
          {% endif %}
          {% if s.priority is not none %}
            <span class="pill">priority {{ s.priority }}</span>
          {% endif %}
          {% if s.sourceType %}
            <span class="pill">{{ s.sourceType }}</span>
          {% endif %}
          {% if s.feedUrl %}
            <a class="pill" href="{{ s.feedUrl }}">feed</a>
          {% endif %}
          {% if ingested and ingested.sources %}
            {% for rs in ingested.sources %}
              {% if rs.id == s.id and rs.lastFetch %}
                {% if rs.lastFetch.ok %}
                  <span class="badge badge--low">OK</span>
                {% else %}
                  <span class="badge badge--high">ERROR</span>
                {% endif %}
                {% if rs.lastFetch.status %}
                  <span class="pill">HTTP {{ rs.lastFetch.status }}</span>
                {% endif %}
                {% if rs.lastFetch.at %}
                  <span class="pill">{{ rs.lastFetch.at }}</span>
                {% endif %}
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
        {% if s.notes %}
          <p class="item__body">{{ s.notes }}</p>
        {% endif %}
        {% if ingested and ingested.sources %}
          {% for rs in ingested.sources %}
            {% if rs.id == s.id and rs.lastFetch and rs.lastFetch.error %}
              <details class="details">
                <summary>Last fetch error</summary>
                <p class="kicker--spaced">{{ rs.lastFetch.error }}</p>
              </details>
            {% endif %}
          {% endfor %}
        {% endif %}
        <details class="details">
          <summary>Source metadata</summary>
          <div class="meta kicker--spaced">
            <span class="pill">id: {{ s.id }}</span>
            {% if s.fetchPolicy %}
              <span class="pill">fetch: {{ s.fetchPolicy }}</span>
            {% endif %}
          </div>
        </details>
      </li>
    {% endfor %}
  </ul>
</section>
