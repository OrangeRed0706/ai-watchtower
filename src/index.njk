---
layout: layouts/base.njk
title: Home
---

<section class="panel">
  <div class="page-title">
    <h1>Latest candidates</h1>
    {% if meta.latestDigest %}
      <div class="subtle">{{ meta.latestDigest.date | prettyDate }}</div>
    {% elif candidates and candidates.available and candidates.run %}
      <div class="subtle">From ingest {{ candidates.run.finishedAt }}</div>
    {% endif %}
  </div>

  {% if meta.latestDigest %}
    <p class="kicker">{{ meta.latestDigest.summary }}</p>

    <div class="split" style="margin-top: 1rem;">
      <div>
        <h2 style="margin: 0 0 0.5rem; font-size: 1.1rem;">Top items</h2>
        <ol class="items">
          {% for item in meta.latestDigest.items %}
            <li class="item">
              <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
              {% if item.snippet %}
                <p>{{ item.snippet }}</p>
              {% endif %}
              <div class="meta">
                <span class="{{ item.impactLevel | impactClass }}">{{ item.impactLevel | upper }} impact</span>
                <span class="pill">{{ item.impactArea }}</span>
                {% for tag in item.tags %}
                  <span class="pill">#{{ tag }}</span>
                {% endfor %}
                {% if item.dedup and item.dedup.groupSize and item.dedup.groupSize > 1 %}
                  <span class="pill">dupes: {{ item.dedup.groupSize }}</span>
                {% endif %}
              </div>
            </li>
          {% endfor %}
        </ol>
      </div>
      <aside class="panel" style="padding: 0.95rem 1rem;">
        <h2 style="margin: 0 0 0.5rem; font-size: 1.1rem;">Quick links</h2>
        <ul class="list">
          <li><a href="{{ '/digests/' | url }}">Digest archive</a></li>
          <li><a href="{{ '/candidates/' | url }}">Digest candidates (pre-summary)</a></li>
          <li><a href="{{ '/dedup/' | url }}">Dedup groups</a></li>
          <li><a href="{{ '/sources/' | url }}">Sources</a></li>
          <li><a href="{{ '/items/' | url }}">Latest items</a></li>
          <li><a href="{{ '/about/' | url }}">About this project</a></li>
        </ul>
        <p class="kicker" style="margin-top: 0.9rem;">
          Static output: <code>public/</code>
        </p>
      </aside>
    </div>

    <p style="margin-top: 1.1rem;">
      Prefer the full daily page?
      <a href="{{ ('/digests/' ~ meta.latestDigest.date ~ '/') | url }}">Open {{ meta.latestDigest.date }}</a>.
    </p>
  {% else %}
    {% if candidates and candidates.available and candidates.items and candidates.items.length %}
      <p class="kicker">
        Daily digest pages aren’t published yet — here are the latest ranked items from the pipeline.
        Browse more on <a href="{{ '/candidates/' | url }}">Candidates</a>.
      </p>
      <h2 style="margin: 1.1rem 0 0.5rem; font-size: 1.1rem;">Top candidates</h2>
      <ol class="items">
        {% for item in candidates.items | slice(0, 10) %}
          <li class="item">
            <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
            {% if item.snippet %}
              <p>{{ item.snippet }}</p>
            {% endif %}
            <div class="meta">
              {% if item.classification %}
                <span class="{{ item.classification.impactLevel | impactClass }}">{{ item.classification.impactLevel | upper }} impact</span>
                <span class="pill">{{ item.classification.impactArea }}</span>
                {% for tag in item.classification.tags %}
                  <span class="pill">#{{ tag }}</span>
                {% endfor %}
              {% endif %}
              {% if item.dedup and item.dedup.groupSize and item.dedup.groupSize > 1 %}
                <span class="pill">dupes: {{ item.dedup.groupSize }}</span>
              {% endif %}
              {% if item.sourceName %}
                <span class="pill">{{ item.sourceName }}</span>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ol>
    {% else %}
      <p class="kicker">
        No pipeline data yet. Run <code>npm run ingest</code>, or browse the current snapshot on
        <a href="{{ '/candidates/' | url }}">Candidates</a>.
      </p>
    {% endif %}
  {% endif %}
</section>

{% if ingested and ingested.items and ingested.items.length %}
  <section class="panel" style="margin-top: 1rem;">
    <div class="page-title">
      <h2 style="margin: 0;">Latest ingested items</h2>
      <div class="subtle">{{ ingested.run.finishedAt }}</div>
    </div>
    <ol class="items">
      {% for item in ingested.items | slice(0, 5) %}
        <li class="item">
          <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
          {% if item.snippet %}
            <p>{{ item.snippet }}</p>
          {% endif %}
          <div class="meta">
            <span class="pill">{{ item.sourceName }}</span>
            {% if item.publishedAt %}
              <span class="pill">{{ item.publishedAt }}</span>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ol>
    <p class="kicker" style="margin-top: 0.9rem;">
      Browse more on <a href="{{ '/items/' | url }}">Items</a>.
    </p>
  </section>
{% endif %}
