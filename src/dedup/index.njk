---
layout: layouts/base.njk
title: Story clusters
permalink: /dedup/index.html
---

<section class="panel">
  <div class="page-title">
    <h1>Story clusters</h1>
    {% if dedupGroups and dedupGroups.available and dedupGroups.stats %}
      <div class="subtle">
        {{ dedupGroups.stats.groups }} group(s) • {{ dedupGroups.stats.itemsIn }} item(s) • {{ dedupGroups.stats.duplicateItems }} duplicate row(s)
      </div>
    {% else %}
      <div class="subtle">No dedup data yet</div>
    {% endif %}
  </div>

  <p class="lede">
    The same story often appears across multiple sources. Clustering helps avoid duplicate coverage and shows how widely an item propagated.
  </p>
  <details class="details">
    <summary>How grouping works</summary>
    <p class="kicker" style="margin-top: 0.45rem;">
      Deterministic cross-source grouping. Primary key is canonical URL; fallback keys are content hash, then (day + normalized title).
    </p>
  </details>

  {% if dedupGroups and dedupGroups.available and dedupGroups.groups and dedupGroups.groups.length %}
    <ol class="items">
      {% for g in dedupGroups.groups | slice(0, 200) %}
        <li class="item">
          <h3 style="margin: 0;">
            {% if g.canonical and g.canonical.url %}
              <a href="{{ g.canonical.url }}">{{ g.canonical.title or g.canonical.url }}</a>
            {% else %}
              {{ g.canonical.title or 'Untitled' }}
            {% endif %}
          </h3>
          <div class="meta">
            <span class="pill">{{ g.members.length }} items</span>
            {% if g.sources and g.sources.length %}
              <span class="pill">{{ g.sources.length }} sources</span>
            {% endif %}
          </div>
          {% if g.sources and g.sources.length %}
            <p class="kicker" style="margin-top: 0.6rem;">
              <strong>Sources:</strong>
              {% for s in g.sources %}
                <a href="{{ s.url }}">{{ s.name }}</a>{% if not loop.last %}, {% endif %}
              {% endfor %}
            </p>
          {% endif %}

          <details class="details">
            <summary>Members & grouping key</summary>
            <div class="meta" style="margin-top: 0.45rem;">
              {% if g.basis %}
                <span class="pill">basis: {{ g.basis }}</span>
              {% endif %}
              <span class="pill"><code>{{ g.key }}</code></span>
            </div>
            <ul class="list">
              {% for m in g.members %}
                <li>
                  {% if m.isCanonical %}<strong>canonical</strong> • {% endif %}
                  {% if m.url %}
                    <a href="{{ m.url }}">{{ m.sourceName or m.sourceId }}</a>
                  {% else %}
                    {{ m.sourceName or m.sourceId }}
                  {% endif %}
                  {% if m.score is not none %} <span class="subtle">(score {{ m.score }})</span>{% endif %}
                </li>
              {% endfor %}
            </ul>
          </details>
        </li>
      {% endfor %}
    </ol>
  {% else %}
    <p class="kicker">
      No published clustering data yet.
    </p>
    <details class="details">
      <summary>For contributors</summary>
      <p class="kicker" style="margin-top: 0.45rem;">
        Generate the data locally with <code>npm run pipeline</code>, then build the site with <code>npm run build</code>.
      </p>
    </details>
  {% endif %}
</section>
