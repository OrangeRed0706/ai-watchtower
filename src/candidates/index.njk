---
layout: layouts/base.njk
title: Ranked candidates
permalink: /candidates/index.html
---

<section class="panel">
  <div class="page-title">
    <h1>Ranked candidates</h1>
    {% if candidates and candidates.available and candidates.items and candidates.items.length %}
      {% set ingestTime = (candidates.run and candidates.run.finishedAt) or candidates.generatedAt %}
      <div class="subtle">
        {% if ingestTime %}Updated {{ ingestTime }} &middot; {% endif %}
        Showing top {{ candidates.topCount }} of {{ candidates.uniqueItems }} unique ({{ candidates.totalItems }} total)
      </div>
    {% else %}
      <div class="subtle">No candidate data yet</div>
    {% endif %}
  </div>

  <p class="lede">
    A ranked shortlist of items likely worth reading right now, with provenance and transparent signals.
    Narrative summaries and cross-item synthesis are not published yet.
  </p>

  <details class="details">
    <summary>Data and methodology</summary>
    <p class="kicker--spaced">
      This view is built from the latest ingestion snapshot and a deterministic scoring + dedup + first-pass classification pass.
    </p>
    {% if candidates and candidates.available and candidates.scoring %}
      <p class="kicker">Scoring: v{{ candidates.scoring.version }} &middot; {{ candidates.scoring.scoredAt }}</p>
    {% endif %}
    {% if candidates and candidates.available and candidates.dedup and candidates.dedup.version %}
      <p class="kicker">Dedup: v{{ candidates.dedup.version }} &middot; {{ candidates.dedup.dedupedAt }}</p>
    {% endif %}
    {% if candidates and candidates.available and candidates.classification and candidates.classification.version %}
      <p class="kicker">Classification: v{{ candidates.classification.version }} &middot; {{ candidates.classification.classifiedAt }}</p>
    {% endif %}
  </details>

  {% if candidates and candidates.available and candidates.items and candidates.items.length %}
    <ol class="items">
      {% for item in candidates.items %}
        <li class="item">
          <h3 class="item__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
          {% if item.snippet %}
            <p class="item__body">{{ item.snippet }}</p>
          {% endif %}
          <div class="meta">
            <span class="pill">#{{ loop.index }}</span>
            {% if item.score is not none %}
              <span class="pill">Score: {{ item.score }}</span>
            {% endif %}
            {% if item.classification %}
              <span class="{{ item.classification.impactLevel | impactClass }}">{{ item.classification.impactLevel | upper }} impact</span>
              <span class="pill">{{ item.classification.impactArea }}</span>
              {% for tag in item.classification.tags %}
                <span class="pill">#{{ tag }}</span>
              {% endfor %}
            {% endif %}
            {% if item.dedup and item.dedup.groupSize and item.dedup.groupSize > 1 %}
              <span class="pill">{{ item.dedup.groupSize }} sources</span>
            {% endif %}
            {% if item.sourceName %}
              <span class="pill">{{ item.sourceName }}</span>
            {% endif %}
            {% if item.publishedAt %}
              <span class="pill">{{ item.publishedAt }}</span>
            {% endif %}
            {% if item.category %}
              <span class="pill">{{ item.category }}</span>
            {% endif %}
          </div>

          {% if (item.scoreReasons and item.scoreReasons.length) or (item.classification and item.classification.reasons and item.classification.reasons.length) or (item.dedupGroup and item.dedupGroup.sources and item.dedupGroup.sources.length > 1) %}
            <details class="details">
              <summary>Why this ranked / provenance</summary>
              {% if item.scoreAgeHours is not none %}
                <p class="kicker--spaced">Score age: {{ item.scoreAgeHours }}h</p>
              {% endif %}

              {% if item.scoreReasons and item.scoreReasons.length %}
                <div class="kicker--spaced"><strong>Ranking signals</strong></div>
                <ul class="reason-list">
                  {% for r in item.scoreReasons | slice(0, 8) %}
                    <li>
                      <code>{{ r.key }}</code>
                      <span class="reason-delta">{{ r.delta }}</span>
                      {% if r.note %}
                        <span class="subtle">({{ r.note }})</span>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}

              {% if item.classification and item.classification.reasons and item.classification.reasons.length %}
                <div class="kicker--spaced"><strong>Classification signals</strong></div>
                <ul class="reason-list">
                  {% for r in item.classification.reasons | slice(0, 8) %}
                    <li>
                      <code>{{ r.key }}</code>
                      {% if r.note %}
                        <span class="subtle">({{ r.note }})</span>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}

              {% if item.dedupGroup and item.dedupGroup.sources and item.dedupGroup.sources.length > 1 %}
                <p class="kicker--spaced">
                  <strong>Also covered by:</strong>
                  {% for s in item.dedupGroup.sources %}
                    <a href="{{ s.url }}">{{ s.name }}</a>{% if not loop.last %}, {% endif %}
                  {% endfor %}
                </p>
              {% endif %}
            </details>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  {% else %}
    <p class="kicker">
      No published candidates yet.
    </p>
    <details class="details">
      <summary>For contributors</summary>
      <p class="kicker--spaced">
        Generate the data locally with <code>npm run pipeline</code>, then build the site with <code>npm run build</code>.
      </p>
    </details>
  {% endif %}
</section>
