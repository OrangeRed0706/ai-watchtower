---
layout: layouts/base.njk
title: Daily briefing
pagination:
  data: meta.allDigests
  size: 1
  alias: digest
permalink: "digests/{{ digest.date }}/index.html"
---

<section class="panel">
  <div class="page-title">
    <h1>Daily briefing</h1>
    <div class="subtle">{{ digest.date | prettyDate }}</div>
  </div>

  {% if digest.summary %}
    <p class="lede">{{ digest.summary }}</p>
  {% else %}
    <p class="lede">A ranked shortlist with links back to original sources.</p>
  {% endif %}

  {% set impactBuckets = ['high', 'medium', 'low'] %}
  {% for level in impactBuckets %}
    <h2 class="section-title mt-16">{{ level | capitalize }} impact</h2>
    <ul class="items">
      {% for item in digest.items %}
        {% if item.impactLevel == level %}
          <li class="item">
            <h3 class="item__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
            {% if item.snippet %}
              <p class="item__body">{{ item.snippet }}</p>
            {% endif %}
            <div class="meta">
              <span class="{{ item.impactLevel | impactClass }}">{{ item.impactLevel | upper }} impact</span>
              <span class="pill">{{ item.impactArea }}</span>
              {% for tag in item.tags %}
                <span class="pill">#{{ tag }}</span>
              {% endfor %}
              {% if item.score is not none %}
                <span class="pill">score: {{ item.score }}</span>
              {% endif %}
              {% if item.dedup and item.dedup.groupSize and item.dedup.groupSize > 1 %}
                <span class="pill">{{ item.dedup.groupSize }} sources</span>
              {% endif %}
            </div>

            {% if item.sources and item.sources.length %}
              <p class="kicker--spaced">
                <strong>Sources:</strong>
                {% for s in item.sources %}
                  <a href="{{ s.url }}">{{ s.name }}</a>{% if not loop.last %}, {% endif %}
                {% endfor %}
              </p>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  {% endfor %}

  <nav class="pager" aria-label="Digest navigation">
    <div>
      {% if pagination.next %}
        <a href="{{ ('/digests/' ~ pagination.next.date ~ '/') | url }}">&larr; {{ pagination.next.date | prettyDate }}</a>
      {% endif %}
    </div>
    <div>
      {% if pagination.previous %}
        <a href="{{ ('/digests/' ~ pagination.previous.date ~ '/') | url }}">{{ pagination.previous.date | prettyDate }} &rarr;</a>
      {% endif %}
    </div>
  </nav>
</section>
