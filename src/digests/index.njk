---
layout: layouts/base.njk
title: Briefing archive
permalink: /digests/index.html
---

<section class="panel">
  <div class="page-title">
    <h1>Briefing archive</h1>
    <div class="subtle">{{ meta.allDigests.length }} day(s)</div>
  </div>

  <p class="lede">
    Daily briefings built from the ranked shortlist on each run.
  </p>

  {% if meta.allDigests and meta.allDigests.length %}
    <ul class="items">
      {% for d in meta.allDigests %}
        {% set highCount = 0 %}
        {% set mediumCount = 0 %}
        {% set lowCount = 0 %}
        {% for it in d.items %}
          {% if it.impactLevel == 'high' %}
            {% set highCount = highCount + 1 %}
          {% elif it.impactLevel == 'medium' %}
            {% set mediumCount = mediumCount + 1 %}
          {% elif it.impactLevel == 'low' %}
            {% set lowCount = lowCount + 1 %}
          {% endif %}
        {% endfor %}
        <li class="item">
          <h3 class="item__title">
            <a href="{{ ('/digests/' ~ d.date ~ '/') | url }}">{{ d.date | prettyDate }}</a>
          </h3>
          <p class="item__body">&middot; {{ d.items.length }} item(s)</p>
          {% if highCount or mediumCount or lowCount %}
            <div class="meta">
              <span class="pill">high {{ highCount }}</span>
              <span class="pill">medium {{ mediumCount }}</span>
              <span class="pill">low {{ lowCount }}</span>
            </div>
          {% endif %}
          {% if d.summary %}
            <p class="kicker--spaced">{{ d.summary }}</p>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="kicker">
      No published briefings yet.
    </p>
    <details class="details">
      <summary>For contributors</summary>
      <p class="kicker--spaced">
        Generate the data locally with <code>npm run pipeline</code>, then build the site with <code>npm run build</code>.
      </p>
    </details>
  {% endif %}
</section>
