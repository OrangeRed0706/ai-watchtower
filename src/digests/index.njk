---
layout: layouts/base.njk
title: Digest archive
permalink: /digests/index.html
---

<section class="panel">
  <div class="page-title">
    <h1>Digest archive</h1>
    <div class="subtle">{{ meta.allDigests.length }} day(s)</div>
  </div>
  <p class="kicker">
    Reverse chronological list of daily candidate shortlists generated from the latest ingestion snapshot.
  </p>

  {% if meta.allDigests and meta.allDigests.length %}
    <ul class="list">
      {% for d in meta.allDigests %}
        <li>
          <a href="{{ ('/digests/' ~ d.date ~ '/') | url }}">{{ d.date | prettyDate }}</a>
          — {{ d.items.length }} item(s)
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="kicker">
      No digests yet. Run <code>npm run ingest</code> then <code>npm run artifacts</code>.
    </p>
  {% endif %}
</section>
