<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
      {%- if title -%}{{ title }} &middot; {%- endif -%}{{ site.name }}
    </title>
    <link rel="stylesheet" href="{{ '/assets/styles.css' | url }}" />
  </head>
  <body class="page-shell">
    <div class="ambient" aria-hidden="true"></div>
    {% include "partials/nav.njk" %}
    <main class="container">
      <section class="notice" role="note" aria-label="Site status">
        <div class="notice__inner">
          <div class="notice__label">Status</div>
          <div class="notice__body">
            {{ site.notice }}
            <a href="{{ '/about/' | url }}">What this is</a>.
          </div>
        </div>
      </section>
      {{ content | safe }}
    </main>
    <footer class="footer">
      <div class="container footer__inner">
        <div>{{ site.name }} &middot; {{ site.tagline }}</div>
        <div>
          <a href="{{ '/about/' | url }}">About</a> &middot;
          <a href="{{ '/sources/' | url }}">Sources</a> &middot;
          <a href="{{ '/digests/' | url }}">Archive</a>
        </div>
      </div>
    </footer>
  </body>
</html>
