{
  "name": "ai-watchtower",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ingest": "node scripts/ingest.js",
    "artifacts": "node scripts/build-artifacts.js",
    "pipeline": "npm run ingest && npm run artifacts",
    "build": "eleventy",
    "dev": "eleventy --serve --watch",
    "clean": "rm -rf public .cache artifacts src/_data/ingested.json"
  },
  "dependencies": {
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1"
  }
}
